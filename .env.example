# Copie para `.env.local` na raiz do projeto (não commite segredos).
# Supabase: Project Settings → API → Project URL e anon/public key.

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Specs de pneus: catálogo local (src/app/data/tireSpecsCatalog.ts) — sem API externa.

# Mapbox — mapa e rotas (Directions API) no formulário de viagens (mapbox.com)
VITE_MAPBOX_TOKEN=

# Google Places API (New) — autocomplete e detalhes de lugares na busca do mapa
# Ative "Places API (New)" no Google Cloud Console e gere uma chave com restrição de HTTP referrer.
VITE_GOOGLE_PLACES_API_KEY=

# Opcional: URI do Postgres para `npm run db:migrate`
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[SENHA]@....pooler.supabase.com:6543/postgres
